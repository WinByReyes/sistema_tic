# ===================================================================
# VARIABLES DE ENTORNO PARA DESPLIEGUE (RENDER + SUPABASE)
# ===================================================================

# Perfil de Spring Boot
SPRING_PROFILES_ACTIVE=prod

# Puerto (Render lo asigna automaticamente, no es necesario configurarlo manualmente en Render)
PORT=8080

# Conexión a Base de Datos Supabase (PostgreSQL)
# Obtén estos valores en Supabase -> Project Settings -> Database -> Connection string -> URI / JDBC
# Formato JDBC con SSL requerido:
DB_URL=jdbc:postgresql://<SUPABASE_HOST>:5432/postgres?sslmode=require
DB_USERNAME=postgres.<YOUR_PROJECT_REF>
DB_PASSWORD=<YOUR_SUPABASE_PASSWORD>

# DDL Auto de Hibernate (update crea o actualiza tablas respetando los datos)
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Clave secreta JWT (Cadena Base64 de minimo 256 bits / 32 bytes)
JWT_SECRET=RkFzZTRfU0lTVEVNQV9USUNfU0VDSVJFXzIwMjZfU0VHVVJPUw==

# Desactivar respaldos locales en Render (Supabase maneja los respaldos en la nube)
BACKUP_ENABLED=false
